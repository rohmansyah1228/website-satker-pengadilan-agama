# ---------------------------------------------------------------------------
# Menjalankan website TANPA "php spark serve" (XAMPP, hosting cPanel/DirectAdmin).
# Semua alamat diarahkan ke folder public/. Folder app/, writable/, vendor/ dan
# berkas .env tidak dapat dibuka dari browser.
# Paling aman di hosting bersama subdomain lain: arahkan Document Root domain
# langsung ke folder public/ (lihat README, bagian "Instalasi di Hosting").
# ---------------------------------------------------------------------------
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # buang garis miring di akhir alamat
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # (opsional, hosting ber-SSL) paksa HTTPS — hapus tanda # pada dua baris berikut
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # (hosting berbagi docroot dgn subdomain lain) agar HANYA domain utama yang
    # diarahkan ke public/, hapus tanda # baris berikut & ganti domainnya:
    # RewriteCond %{HTTP_HOST} ^(www\.)?domain-anda\.go\.id$ [NC]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

# Tolak akses ke berkas konfigurasi & berkas sensitif (berlaku di semua hosting)
<FilesMatch "(?i)(^\.|^composer\.(json|lock)$|^package(-lock)?\.json$|^phpunit\.xml(\.dist)?$|^error_log$|\.(env|ini|log|sql|sqlite|bak|backup|old|orig|save|swp|tmp|dist|pem|key|lock|sh|conf|md)$)">
    Require all denied
</FilesMatch>
