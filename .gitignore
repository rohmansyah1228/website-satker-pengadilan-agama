# Dependensi & konfigurasi lokal
# vendor/ disertakan (CodeIgniter & HTMLPurifier) agar bisa dipasang di hosting tanpa Composer
/vendor/*
!/vendor/codeigniter4/
!/vendor/ezyang/
/vendor/codeigniter4/framework/tests/
/writable/installed.lock
.env
composer.phar

# Data runtime (jangan pernah di-commit)
/writable/*.db
/writable/*.sqlite
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/images/
/public/uploads/images/*
!/public/uploads/images/.gitkeep

# Data satker (berita, dokumen, database) tidak pernah masuk repositori
*.sql
*.sql.gz
*.sqlite
*.bak
/backup*/
/cadangan*/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
/writable/backups/*
!/writable/backups/index.html
