#--------------------------------------------------------------------
# Website Satker Peradilan Agama — salin menjadi .env lalu sesuaikan
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

app.baseURL = 'https://www.pa-contoh.go.id/'
# Alamat panel admin — ganti dengan nama yang sulit ditebak
app.adminPath = 'panel-satker'
app.forceGlobalSecureRequests = true

# Buat dengan: php spark key:generate
encryption.key =

# Database website (akun khusus, BUKAN root — Bab II huruf E)
database.default.hostname = 127.0.0.1
database.default.database = website_satker
database.default.username = web_satker
database.default.password =
database.default.DBDriver = MySQLi
database.default.charset  = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port     = 3306

# (Opsional) Koneksi READ-ONLY ke database SIPP untuk jadwal sidang
# database.sipp.hostname = 127.0.0.1
# database.sipp.database = sipp
# database.sipp.username = web_sipp_readonly
# database.sipp.password =
# database.sipp.DBDriver = MySQLi
# database.sipp.charset  = utf8mb4

# Cookie & session aman (HTTPS)
cookie.secure   = true
cookie.httponly = true
cookie.samesite = Lax
session.cookieName = satker_session
session.expiration = 7200
session.matchIP = false

# Password awal Super Admin saat seeding (hapus baris ini setelah instalasi)
# SEED_ADMIN_PASSWORD =
